{
    "$schema": "https://schemas.liberu.dev/module/v1.json",
    "name": "real-estate-viewings-api",
    "display_name": "Real Estate Viewings API",
    "description": "Versioned team-scoped API adapter for viewings.",
    "version": "1.0.0",
    "category": "adapter",
    "provider": "Liberu\\RealEstate\\ViewingsApi\\ViewingsApiServiceProvider",
    "requires": {
        "php": "^8.5",
        "laravel": "^13.0",
