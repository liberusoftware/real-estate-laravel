{
    "$schema": "https://schemas.liberu.dev/module/v1.json",
    "name": "real-estate-properties",
    "display_name": "Real Estate Properties",
    "description": "Address, categories, units, characteristics, tenure, utilities, features, status, history, keys, and walkability scores.",
    "version": "1.0.3",
    "category": "product",
    "provider": "Liberu\\RealEstate\\Properties\\PropertiesServiceProvider",
    "requires": {
        "php": "^8.5",
        "laravel": "^13.0",
        "packages": {
            "liberusoftware/audit": "^1.0",
            "liberusoftware/module-manager": "^1.0",
            "liberusoftware/organizations-teams": "^1.0",
            "liberusoftware/real-estate-core": "^1.0"
        }
    },
    "suggests": {
        "liberusoftware/real-estate-properties-api": "^1.0",
        "liberusoftware/real-estate-properties-filament": "^1.0",
        "liberusoftware/real-estate-properties-livewire": "^1.0"
    },
    "capabilities": [
        "real-estate.properties"
    ],
    "default_enabled": true,
    "features": [
        "Address/location",
        "Categories",
        "Templates",
        "Favorites",
        "Saved searches",
        "Community events",
        "Reviews",
        "Neighborhoods",
        "Neighborhood reviews",
        "Price alerts",
        "Units",
        "Characteristics",
        "Tenure",
        "Utilities",
        "Features",
        "Status",
        "History",
        "Keys",
        "Property detail disclosures",
        "Property comparisons",
        "Property tax estimates",
        "AR tours",
        "Walkability scores",
        "Property QR codes",
        "Property sharing"
    ]
}
