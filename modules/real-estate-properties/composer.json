{
    "name": "liberusoftware/real-estate-properties",
    "description": "Provider-neutral real-estate property records and lifecycle actions.",
    "type": "liberu-module",
    "version": "1.0.1",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "illuminate/database": "^13.0",
        "illuminate/events": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/mail": "^13.0",
        "illuminate/validation": "^13.0",
        "liberusoftware/module-manager": "^1.0",
        "liberusoftware/organizations-teams": "^1.0",
        "liberusoftware/real-estate-core": "^1.0",
        "liberusoftware/audit": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Liberu\\RealEstate\\Properties\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Liberu\\RealEstate\\Properties\\Tests\\": "tests/"
        }
    },
    "extra": {
        "liberu": {
            "name": "real-estate-properties"
        }
    },
    "require-dev": {
        "pestphp/pest": "^5.0"
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
