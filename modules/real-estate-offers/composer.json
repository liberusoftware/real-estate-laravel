{
    "name": "liberusoftware/real-estate-offers",
    "description": "Provider-neutral offer terms, qualification, negotiation, proof, and acceptance actions.",
    "type": "liberu-module",
    "version": "1.0.0",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "illuminate/database": "^13.0",
        "illuminate/validation": "^13.0",
        "liberusoftware/module-manager": "^1.0",
        "liberusoftware/organizations-teams": "^1.0",
        "liberusoftware/audit": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Liberu\\RealEstate\\Offers\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Liberu\\RealEstate\\Offers\\OffersServiceProvider"
            ]
        },
        "liberu": {
            "name": "real-estate-offers"
        }
    },
    "require-dev": {
        "pestphp/pest": "^5.0"
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
