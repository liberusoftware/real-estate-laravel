{
    "name": "liberusoftware/identity-core-api",
    "description": "Sanctum Bearer token issuance HTTP adapter for identity-core.",
    "type": "liberu-module",
    "version": "1.0.0",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "illuminate/http": "^13.38.0",
        "illuminate/routing": "^13.38.0",
        "laravel/sanctum": "^4.3.3",
        "laravel/fortify": "^1.41.0",
        "spatie/laravel-permission": "^8.3.2",
        "liberusoftware/identity-core": "^1.0",
        "liberusoftware/organizations-teams": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Liberu\\Foundation\\IdentityCoreApi\\": "src/"
        }
    },
    "extra": {
        "liberu": {
            "name": "identity-core-api"
        }
    },
    "require-dev": {
        "pestphp/pest": "^5.3.3"
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
