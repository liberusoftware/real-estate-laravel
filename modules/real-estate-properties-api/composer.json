{
    "name": "liberusoftware/real-estate-properties-api",
    "description": "Versioned API adapter for real-estate properties.",
    "type": "liberu-module",
    "version": "1.0.1",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "illuminate/http": "^13.38.0",
        "illuminate/routing": "^13.38.0",
        "liberusoftware/real-estate-properties": "^1.0",
        "liberusoftware/real-estate-media-and-documents": "^1.0",
        "liberusoftware/organizations-teams": "^1.0",
        "liberusoftware/currency-context": "^1.0"
    },
    "autoload": {"psr-4": {"Liberu\\RealEstate\\PropertiesApi\\": "src/"}},
