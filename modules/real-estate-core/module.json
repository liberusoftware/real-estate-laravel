{
    "$schema": "https://schemas.liberu.dev/module/v1.json",
    "name": "real-estate-core",
    "display_name": "Real Estate Core",
    "description": "Team-scoped agencies, branches, statuses, terminology, and operational numbering.",
    "version": "1.0.1",
    "category": "product",
    "provider": "Liberu\\RealEstate\\Core\\RealEstateCoreServiceProvider",
    "requires": {
        "php": "^8.5",
        "laravel": "^13.0",
        "packages": {
            "liberusoftware/module-manager": "^1.0",
            "liberusoftware/organizations-teams": "^1.0"
        }
    },
    "suggests": {
        "liberusoftware/real-estate-core-api": "^1.0",
        "liberusoftware/real-estate-core-filament": "^1.0",
        "liberusoftware/real-estate-core-livewire": "^1.0"
    },
    "capabilities": ["real-estate.core"],
    "default_enabled": true,
    "features": ["Agencies", "Branches", "Teams", "Territories", "Terminology", "Statuses", "Numbering", "Audit"]
}
