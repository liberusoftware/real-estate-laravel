{
    "name": "liberu-real-estate/real-estate-laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "bezhansalleh/filament-shield": "^4.3.1",
        "bursteri/socialstream": "^7.0",
        "docusign/esign-client": "^8.8.1",
        "filament/filament": "^5.7.3",
        "filament/spatie-laravel-media-library-plugin": "^5.7.3",
        "filament/spatie-laravel-settings-plugin": "^5.7.3",
        "guzzlehttp/guzzle": "^7.15.1",
        "laravel/framework": "^13.22",
        "laravel/horizon": "^5.48.1",
        "laravel/jetstream": "^5.5.3",
        "laravel/octane": "^2.18",
        "laravel/reverb": "^1.11",
        "laravel/sanctum": "^4.3.3",
        "laravel/tinker": "^3.0.2",
        "livewire/livewire": "^4.3.3",
        "spatie/laravel-analytics": "^5.7.1",
        "spatie/laravel-googletagmanager": "^3.1.1",
        "spatie/laravel-medialibrary": "^11.23.3",
        "spatie/laravel-menu": "^4.2.2",
        "spatie/laravel-permission": "^8.3",
        "spatie/menu": "^3.2.1",
        "spiral/roadrunner-cli": "^2.7.2",
        "spiral/roadrunner-http": "^3.6.0",
        "stripe/stripe-php": "^20.3.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24.1",
        "filament/upgrade": "^5.7.3",
        "laravel/pint": "^1.29.3",
        "laravel/sail": "^1.64",
        "mockery/mockery": "^1.6.12",
        "nunomaduro/collision": "^8.9.5",
        "phpunit/phpunit": "^13.2.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
