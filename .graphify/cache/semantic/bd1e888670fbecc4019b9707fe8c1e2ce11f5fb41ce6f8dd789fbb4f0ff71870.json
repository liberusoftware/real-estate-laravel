{"nodes":[{"id":"doc_handoff_conformance_map","label":"Handoff: Conformance Map (2026-08-04)","file_type":"document","source_file":"docs/handoffs/2026-08-04-conformance-map.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":null},{"id":"concept_conformance_spec","label":"docs/CONFORMANCE.md","file_type":"document","source_file":"docs/handoffs/2026-08-04-conformance-map.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"The conformance deliverable: scope, every decision with its enforcement mechanism, the defect register, and the step -1 to 9 migration sequence with gates and rollback. Later step blocks correct earlier prose in the same document.","entity_type":"concept"},{"id":"concept_wayfinder_map_612","label":"Wayfinder map issue #612","file_type":"document","source_file":"docs/handoffs/2026-08-04-conformance-map.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Closed at 15/15 tickets; its destination was a spec and no production code changed. A fresh effort means a fresh map, not reopening it.","entity_type":"concept"},{"id":"concept_vendor_naming_decision","label":"liberusoftware vs liberu vendor prefix","file_type":"document","source_file":"docs/handoffs/2026-08-04-conformance-map.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"The vendor was taken as liberu/* early then reversed by the owner back to liberusoftware/*. This puts the repo in deliberate disagreement with liberusoftware/documentation, which mandates liberu/* — a documentation PR is owed.","entity_type":"concept"},{"id":"concept_composer_install_clobber_trap","label":"Root composer install clobbers tracked packages","file_type":"document","source_file":"docs/handoffs/2026-08-04-conformance-map.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"A root install reinstalls every package from Packagist over the tracked /modules and /themes files. git checkout alone does not recover it — untracked files the published packages brought in survive and can be committed as if they were real work.","entity_type":"concept"},{"id":"concept_allow_plugins_defect","label":"Missing config.allow-plugins across packages","file_type":"document","source_file":"docs/handoffs/2026-08-04-conformance-map.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"0 of 48 packages declared config.allow-plugins, so composer update fails inside every package because pestphp/pest-plugin is blocked; --no-plugins is a measurement workaround, not the fix.","entity_type":"concept"},{"id":"concept_verify_before_asserting","label":"Verify before asserting","file_type":"document","source_file":"docs/handoffs/2026-08-04-conformance-map.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Several confident claims were wrong on inspection: a CI gate of --min=83 measuring 5.6%, twelve architecture rules of which two never worked, and 'standalone-testable' packages that could not install standalone.","entity_type":"concept"}],"edges":[{"source":"doc_handoff_conformance_map","target":"concept_conformance_spec","relation":"references","confidence":"EXTRACTED","confidence_score":1,"source_file":"docs/handoffs/2026-08-04-conformance-map.md","source_location":null,"weight":1},{"source":"doc_handoff_conformance_map","target":"concept_wayfinder_map_612","relation":"references","confidence":"EXTRACTED","confidence_score":1,"source_file":"docs/handoffs/2026-08-04-conformance-map.md","source_location":null,"weight":1},{"source":"doc_handoff_conformance_map","target":"concept_vendor_naming_decision","relation":"references","confidence":"EXTRACTED","confidence_score":1,"source_file":"docs/handoffs/2026-08-04-confo