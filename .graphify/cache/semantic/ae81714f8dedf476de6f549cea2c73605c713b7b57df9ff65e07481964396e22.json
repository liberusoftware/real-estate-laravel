{"nodes":[{"id":"doc_theme_architecture","label":"Theme Architecture","file_type":"document","source_file":"docs/THEME_ARCHITECTURE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":null},{"id":"concept_liberu_theme_package","label":"liberu-theme Composer package","file_type":"document","source_file":"docs/THEME_ARCHITECTURE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Themes are independent Composer packages installed into tracked /themes/{name} directories and own presentation only; business rules, authorization, queries and mutations stay in modules.","entity_type":"concept"},{"id":"concept_theme_json_manifest","label":"theme.json manifest","file_type":"document","source_file":"docs/THEME_ARCHITECTURE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Declares name, label, version, provider, type, parent, colors and the declared asset entries.","entity_type":"concept"},{"id":"concept_theme_inheritance","label":"Theme parent inheritance chain","file_type":"document","source_file":"docs/THEME_ARCHITECTURE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Child themes override only differing assets and inherit views/assets through a finite, validated parent chain; view lookup is child theme, parent chain, module default, then application fallback.","entity_type":"concept"},{"id":"concept_theme_base","label":"liberusoftware/theme-base","file_type":"document","source_file":"docs/THEME_ARCHITECTURE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Shared root theme: accessible layout, semantic tokens, cascade layers and progressive JS primitives.","entity_type":"concept"},{"id":"concept_theme_default","label":"liberusoftware/theme-default","file_type":"document","source_file":"docs/THEME_ARCHITECTURE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":null,"entity_type":"concept"},{"id":"concept_theme_dark","label":"liberusoftware/theme-dark","file_type":"document","source_file":"docs/THEME_ARCHITECTURE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Dark presentation achieved purely through token overrides on base.","entity_type":"concept"},{"id":"concept_theme_clear_signal","label":"liberusoftware/theme-clear-signal","file_type":"document","source_file":"docs/THEME_ARCHITECTURE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":null,"entity_type":"concept"},{"id":"concept_composer_installer_plugin","label":"liberusoftware/composer-installer","file_type":"document","source_file":"docs/THEME_ARCHITECTURE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Composer 2 plugin handling both liberu-theme and liberu-module: validates kebab-case installer names, rejects unsafe paths and collisions, and installs deterministically to /themes or /modules.","entity_type":"concept"},{"id":"concept_tracked_installed_directories","label":"Tracked installed package directories","file_type":"document","source_file":"docs/THEME_ARCHITECTURE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Consuming applications commit both the lockfile and the reproduced /modules and /themes trees; root path repositories let Composer recognize the tracked source at the installer path instead of overwriting it.","entity_type":"concept"},{"id":"concept_theme_resolution_precedence","label":"Theme selection precedence","file_type":"document","source_file":"docs/THEME_ARCHITECTURE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Tenant-and-surface, then site-and-surface, then configured surface, then safe default. User/session preference may only select a discovered compatible theme; invalid selections warn and fall back.","entity_type":"concept"},{"id":"concept_theme_validate_command","label":"theme:validate / theme:cache / theme:clear","file_type":"document","source_file":"docs/THEME_ARCHITECTURE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":null,"entity_type":"concept"},{"id":"concept_semantic_design_tokens","label":"Semantic design tokens","file_type":"document","source_file":"docs/THEME_ARCHITECTURE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Themes consume tokens for light, dark, contrast, state, focus, motion, spacing, typography, radius, elevation, borders, breakpoints and layering rather than hard-coded values.","entity_type":"concept"},{"id":"concept_theme_accessibility_requirements","label":"Theme accessibility requirements","file_type":"document","source_file":"docs/THEME_ARCHITECTURE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"WCAG 2.2 AA target verified with automated checks plus keyboard and screen-reader journeys; CSS honors reduced motion, forced colors and bidirectional layout; JS is progressive and CSP-safe.","entity_type":"concept"},{"id":"concept_deterministic_theme_build","label":"Deterministic theme builds","file_type":"document","source_file":"docs/THEME_ARCHITECTURE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Builds fail on missing manifest assets or unresolved imports; /public/build is deployment output while source assets remain in each package.","entity_type":"concept"},{"id":"concept_theme_release_upgrade","label":"Theme release and upgrade flow","file_type":"document","source_file":"docs/THEME_AR