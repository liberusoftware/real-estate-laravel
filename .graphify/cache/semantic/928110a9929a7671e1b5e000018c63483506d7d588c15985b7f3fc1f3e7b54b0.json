{"nodes":[{"id":"doc_handoff_testbench_migration","label":"Handoff: Step 4 Testbench Migration (2026-08-05)","file_type":"document","source_file":"docs/handoffs/2026-08-05-step-4-testbench-migration.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":null},{"id":"concept_package_testbench","label":"liberusoftware/package-testbench","file_type":"document","source_file":"docs/handoffs/2026-08-05-step-4-testbench-migration.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Shared test harness every package dev-requires; version 1.2.0 implements all seven boundary rules that were being kept in the host, making their deletion safe.","entity_type":"concept"},{"id":"concept_migrate_testbench_script","label":"scripts/migrate-testbench","file_type":"document","source_file":"docs/handoffs/2026-08-05-step-4-testbench-migration.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Idempotent fleet migration script, piloted on analytics-core and reverted, moved out of the scratchpad because WSL wipes /tmp on restart.","entity_type":"concept"},{"id":"concept_packagist_blocker","label":"Packagist namespace registration blocker","file_type":"document","source_file":"docs/handoffs/2026-08-05-step-4-testbench-migration.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Nine packages 404 on Packagist, blocking the fleet migration because each package must resolve package-testbench standalone. The fallback is a per-package repositories vcs entry, which unblocks immediately at the cost of a later cleanup release wave.","entity_type":"concept"},{"id":"concept_modules_is_composer_output","label":"modules/ is Composer output","file_type":"document","source_file":"docs/handoffs/2026-08-05-step-4-testbench-migration.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"vendor/composer/installed.json owns the autoload map and is written from each package's published composer.json, so a rename makes the host unbootable until the wave is published. The gate for a rename is each package's own suite, never the host's.","entity_type":"concept"},{"id":"concept_publish_whole_fleet","label":"Publishing mirrors all packages, not just changed ones","file_type":"document","source_file":"docs/handoffs/2026-08-05-step-4-testbench-migration.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Sweeping only changed packages let three stale packages and one regression reach GitHub; the whole fleet must be swept.","entity_type":"concept"},{"id":"concept_version_fields_load_bearing","label":"composer.json version fields are load-bearing","file_type":"document","source_file":"docs/handoffs/2026-08-05-step-4-testbench-migration.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"ModuleValidator compares each manifest against Composer\\InstalledVersions, so a bumped manifest fails the boot until the package is published, tagged and composer update'd — expect a red host in between.","entity_type":"concept"},{"id":"concept_tag_predating_fix","label":"A tag whose commit predates a fix","file_type":"document","source_file":"docs/handoffs/2026-08-05-step-4-testbench-migration.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Composer resolves the tag, not main, so a stale tag is worse than no tag; bumping and re-tagging closed the gate.","entity_type":"concept"},{"id":"concept_architecture_boundary_rules","label":"Host architecture boundary rules","file_type":"document","source_file":"docs/handoffs/2026-08-05-step-4-testbench-migration.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"ModuleBoundariesTest held 15 rules; seven moved to the testbench and the survivors are the whole-graph ones — theme parents resolving, Composer owning every autoload boundary, cross-package namespace dependencies, one Composer vendor, and the two enablement rules.","entity_type":"concept"},{"id":"concept_reusable_workflows","label":"liberusoftware/.github reusable workflows","file_type":"document","source_file":"docs/handoffs/2026-08-05-step-4-testbench-migration.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Three reusable workflows so every repository gets real CI without carrying a copy of the workflow body.","entity_type":"concept"},{"id":"concept_handoff_location_rule","label":"Handoffs live in docs/handoffs/","file_type":"document","source_file":"docs/handoffs/2026-08-05-step-4-testbench-migration.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"CLAUDE.md overrides the /handoff skill's temp-directory default because WSL wipes /tmp exactly when the next session needs the document.","entity_type":"concept"},{"id":"concept_packagist_token_handling","label":"Packagist token stays out of the session","file_type":"document","source_file":"docs/handoffs/2026-08-05-step-4-testbench-migration.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"The token was never shared or stored; it belongs in ~/.config/composer/auth.json or a GitHub Actions secret, never in a repo or a chat transcript.","entity_type":"concept"}],"edges":[{"source":"doc_handoff_testbench_migration","target":"concept_conformance_spec","relation":"references","confidence":"EXTRACTED","confidence_score":1,"source_file":"docs/handoffs/2026-08-05-step-4-testbench-migration.md","source_location":null,"weight":1},{"source":"doc_handoff_testbench_migration","target":"concept_package_testbench","relation":"refere