{"nodes":[{"id":"doc_claude_md","label":"CLAUDE.md — project instructions","file_type":"document","source_file":"CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Single guidance file for Claude Code; documents the composition-host shape so an agent searches modules/ rather than app/."},{"id":"concept_composition_host","label":"Composition host","file_type":"document","source_file":"CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"app/ holds exactly five files; search, theming, localization, settings, roles and observability live in 40 liberu-module packages and 4 liberu-theme packages. Before assuming a class lives in app/, search modules/.","entity_type":"concept"},{"id":"concept_module_system","label":"Module system","file_type":"document","source_file":"CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":null,"entity_type":"concept"},{"id":"entity_module_json","label":"module.json manifest","file_type":"document","source_file":"CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Declares provider class, capabilities, required packages and capabilities, default_enabled and Filament plugins — the single source of truth for enablement.","entity_type":"concept"},{"id":"entity_module_manager_provider","label":"ModuleManagerServiceProvider","file_type":"document","source_file":"CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"First entry in bootstrap/providers.php so discovery runs before anything depends on it.","entity_type":"concept"},{"id":"entity_module_registry","label":"ModuleRegistry::resolve","file_type":"document","source_file":"CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Validates constraints with Semver and returns providers in dependency order; disabling a required module raises DependencyResolutionFailed rather than quietly omitting it.","entity_type":"concept"},{"id":"concept_install_never_boots","label":"Installation never implies boot","file_type":"document","source_file":"CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"No package declares extra.laravel.providers, so Laravel auto-discovery registers nothing and enablement stays an explicit, separate decision. An architecture rule asserts this stays true.","entity_type":"concept"},{"id":"concept_default_enabled","label":"Manifest default_enabled","file_type":"document","source_file":"CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"True for 37 of 40; false for analytics-google, analytics-meta and localization-mymemory, which need third-party credentials so ship installed but off. Adding a module to a composition is therefore installing it — there is no second list to remember.","entity_type":"concept"},{"id":"entity_config_modules","label":"config/modules.php env overrides","file_type":"document","source_file":"CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Holds only MODULES_ENABLED and MODULES_DISABLED, both empty; disabled beats both. Config stays list-free so it cannot become a second source of truth that drifts.","entity_type":"concept"},{"id":"entity_module_plugins","label":"App\\Filament\\ModulePlugins","file_type":"document","source_file":"CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Instantiates only the plugins of enabled modules, rejecting duplicate ids and non-Plugin types — the runtime guard that always fires before any static rule could.","entity_type":"concept"},{"id":"entity_theme_colors","label":"App\\Support\\ThemeColors","file_type":"document","source_file":"CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Maps a theme's colors.primary to a Filament palette (unknown → Amber); panel composition is a host concern, so it moved to app/ when foundation-filament dissolved.","entity_type":"concept"},{"id":"entity_admin_panel_provider","label":"AdminPanelProvider","file_type":"code","source_file":"CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Default panel at /admin, tenant-scoped to the Team model with Shield's SyncShieldTenant as persistent tenant middleware."},{"id":"entity_app_panel_provider","label":"AppPanelProvider","file_type":"code","source_file":"CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Panel at /app, deliberately not tenant-scoped and open to any authenticated user."},{"id":"concept_dual_filament_panels","label":"Dual Filament panels","file_type":"document","source_file":"CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Both append SetLocale and SecurityHeaders to ->middleware([]) because Filament panels do not run the web group.","entity_type":"concept"},{"id":"entity_user_model","label":"App\\Models\\User (host composition model)","file_type":"code","source_file":"CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Implements seven contracts from four packages; role checks query the pivot team-agnostically because Spatie's hasRole() is bound to an active team context that is unset when canAccessPanel() or the Telescope/Pulse gates run."},{"id":"concept_tenancy_rules","label":"Tenancy rules that bite","file_type":"document","source_file":"CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"A Resource whose model has no team() relationship must override isScopedToTenant(); shield:generate must run inside a team context; filament-shield tenant_model and permission models.team are deliberately null.","entity_type":"concept"},{"id":"entity_filament_shield","label":"Filament Shield","file_type":"document","source_file":"CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":null,"entity_type":"concept"},{"id":"entity_spatie_permission","label":"Spatie Permission (team-scoped roles)","file_type":"document","source_file":"CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"permission.teams => true, so roles carry a team_id and Spatie already isolates roles by team — which is why the authorization presentation module disables Shield's tenant resource scoping.","entity_type":"concept"},{"id":"entity_module_boundaries_test","label":"tests/Architecture/ModuleBoundariesTest","file_type":"document","source_file":"CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Holds 8 whole-graph rules only; a rule a package can check about itself belongs in the testbench, because a host rule could only ever fail in the host, which is not where the fault is.","entity_type":"concept"},{"id":"concept_rule_must_be_able_to_fire","label":"A rule that cannot fire is not coverage","file_type":"document","source_file":"CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Plugin-id uniqueness and renamed-package rules were dropped because ModulePlugins and ModuleValidationGuard reject those conditions first; each was mutation-tested and the failure came from the runtime guard, not the rule.","entity_type":"concept"},{"id":"entity_package_testbench","label":"liberusoftware/package-testbench","file_type":"document","source_file":"CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Owns PackageTestCase, PackageRoot, three shipped Boundary suites and the shared TestUser, plus Pint and PHPStan and their configs — so a new boundary rule is one testbench release rather than a 44-repository sweep.","entity_type":"concept"},{"id":"concept_standalone_testable_packages","label":"Packages are standalone-testable","file_type":"document","source_file":"CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Each package carries require-dev, its own phpunit.xml and a thin caller of the reusable workflows; a test belongs in a package only if it needs nothing from the host.","entity_type":"concept"},{"id":"entity_tests_gitkeep","label":"tests/.gitkeep is load-bearing","file_type":"document","source_file":"CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Git does not track an empty directory, so a package with no tests of its own published without tests/ at all and Pest aborted with 'The test directory [tests] does not exist'. 34 packages shipped that way once.","entity_type":"concept"},{"id":"entity_test_user","label":"TestUser / UsesTestUser","file_type":"document","source_file":"CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Loads the base users migration and brings RefreshDatabase; it implements none of the fleet's actor contracts because doing so would make the testbench require Horizon, Pulse, Telescope, Jetstream, Socialite and Socialstream in all 44 dev trees.","entity_type":"concept"},{"id":"entity_fleet_script","label":"scripts/fleet","file_type":"document","source_file":"CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Clones, runs, commits and pushes across the package repositories but deliberately stops short of tagging: a push is recoverable, a tag is what Packagist publishes and what ModuleValidator pins the host to, so an unattended bad wave would be 44 revert-tags.","entity_type":"concept"},{"id":"entity_publish_components","label":"scripts/publish-components (removed)","file_type":"document","source_file":"CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Rsynced the monorepo into the package repositories — the opposite direction to the flip — and was removed once the coverage-ratchet wave proved a fleet-wide change could ship through fleet alone.","entity_type":"concept"},{"id":"concept_packagist_naming","label":"Packagist names drop the module- prefix","file_type":"document","source_file":"CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"liberusoftware/module-search on GitHub is liberusoftware/search on Packagist.","entity_type":"concept"},{"id":"entity_module_validator","label":"ModuleValidator","file_type":"document","source_file":"CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Compares each manifest against Composer\\InstalledVersions, which is why the fleet must keep a version field that composer validate --strict rejects.","entity_type":"concept"},{"id":"entity_module_validation_guard","label":"ModuleValidationGuard","file_type":"document","source_file":"CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Fails the boot with 'Composer package is not installed' before any architecture rule body runs.","entity_type":"concept"},{"id":"concept_theme_system","label":"Theme packages and inheritance","file_type":"document","source_file":"CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"base is the shared root and the only theme shipping layouts/app.blade.php, so every public theme renders through the fallback.","entity_type":"concept"},{"id":"entity_theme_json","label":"theme.json manifest","file_type":"document","source_file":"CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":null,"entity_type":"concept"},{"id":"entity_theme_manager","label":"ThemeManager::inheritanceChain","file_type":"document","source_file":"CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Walks the parent chain with a cycle guard.","entity_type":"concept"},{"id":"entity_theme_discovery","label":"ThemeDiscovery (Composer-driven)","file_type":"document","source_file":"CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Merges the tracked themes/ tree with InstalledVersions::getInstalledPackagesByType('liberu-theme'), deduping by realpath so a theme present both ways is one theme; a composition with no themes/ discovers nothing rather than throwing.","entity_type":"concept"},{"id":"concept_vite_theme_inputs","label":"Vite inputs are derived, not listed","file_type":"document","source_file":"CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"vite.config.js reads every themes/*/theme.json and flattens assets.css and assets.js, so installing a theme package is enough to get it built — and a typo in assets fails the build, which is why an architecture rule checks the files exist.","entity_type":"concept"},{"id":"entity_set_locale_middleware","label":"SetLocale middleware","file_type":"document","source_file":"CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Resolves request param → session → users.locale → Accept-Language → default; precedence request > session > user means a stale session locale can shadow a freshly logged-in user.","entity_type":"concept"},{"id":"entity_language_switcher","label":"LanguageSwitcher (localization-core-livewire)","file_type":"document","source_file":"CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Not mounted anywhere yet.","entity_type":"concept"},{"id":"entity_localization_mymemory","label":"localization-mymemory adapter","file_type":"document","source_file":"CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Disabled by default; it require-devs localization-core so its suite can boot a real TranslationProviderRegistry while staying free of the implementation at runtime.","entity_type":"concept"},{"id":"entity_contract_packages","label":"Contract packages (analytics-contracts, localization-contracts)","file_type":"document","source_file":"CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Small type: library packages carrying no manifest, used where an adapter needs implementation independence.","entity_type":"concept"},{"id":"concept_operations_stack","label":"Operations stack (Horizon, Octane, Telescope, Pulse)","file_type":"document","source_file":"CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Octane evaluates panel ->colors() once at worker boot, so a colour change needs a worker restart.","entity_type":"concept"},{"id":"concept_reverb_unwired","label":"Reverb is installed but not wired","file_type":"document","source_file":"CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"resources/js/app.js is empty, there is no Echo client and routes/channels.php holds only Laravel's default channel — treat real-time as an available dependency, not a working feature.","entity_type":"concept"},{"id":"concept_upgrade_blockers","label":"Known upgrade blockers","file_type":"document","source_file":"CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"spatie/laravel-permission v8 is blocked by filament-shield ~4.x; spiral/roadrunner-http v4 is blocked by laravel/octane ^2.","entity_type":"concept"},{"id":"concept_phpstan_ratchet","label":"Per-package PHPStan level ratchet","file_type":"document","source_file":"CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"A phpstan-level input per repository set from a measured baseline and raised only; unset is -1 rather than 0 because 0 is a real level. The host analyses app/ only, because a package is honest only when analysed against the tree a consumer installs.","entity_type":"concept"},{"id":"concept_shared_pint_phpstan","label":"Shared Pint and PHPStan configs via --config","file_type":"document","source_file":"CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"PINT.md asks for a pint.json per repository; this deviates because 44 committed copies is how configurations become inconsistent, and Pint has no include mechanism so a shared ruleset is only reachable through --config.","entity_type":"concept"},{"id":"concept_agent_handoffs","label":"Session handoffs in docs/handoffs/","file_type":"document","source_file":"CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Never in /tmp: WSL's /tmp is wiped on restart and invisible to everyone else, so a handoff written there is lost precisely when the next session needs it.","entity_type":"concept"},{"id":"concept_host_measures_host","label":"The host measures the host","file_type":"document","source_file":"CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Coverage <source> is app alone; the Modules and Themes suites were dropped because root autoload-dev maps only Tests\\, so they died with 'Class …\\Tests\\TestCase not found' the moment anything reinstalled.","entity_type":"concept"}],"edges":[{"source":"doc_claude_md","target":"concept_composition_host","relation":"references","confidence":"EXTRACTED","confidence_score":1,"source_file":"CLAUDE.md","source_location":null,"weight":1},{"source":"doc_claude_md","target":"concept_module_system","relation":"references","confidence":"EXTRACTED","confidence_score":1,"source_file":"CLAUDE.md","source_location":null,"weight":1},{"source":"doc_claude_md","target":"concept_dual_filament_panels","relation":"references","confidence":"EXTRACTED","confidence_score":1,"source_file":"CLAUDE.md","source_location":null,"weight":1},{"source":"doc_claude_md","target":"concept_tenancy_rules","relation":"references","confidence":"EXTRACTED","confidence_score":1,"source_file":"CLAUDE.md","source_location":null,"weight":1},{"source":"doc_claude_md","target":"concept_theme_system","relation":"references","confidence":"EXTRACTED","confidence_score":1,"source_file":"CLAUDE.md","source_location":null,"weight":1},{"source":"doc_claude_md","target":"concept_standalone_testable_packages","relation":"references","confidence":"EXTRACTED","confidence_score":1,"source_file":"CLAUDE.md","source_location":null,"weight":1},{"source":"doc_claude_md","target":"concept_operations_stack","relation":"references","confidence":"EXTRACTED","confidence_score":1,"source_file":"CLAUDE.md","source_location":null,"weight":1},{"source":"doc_claude_md","target":"concept_upgrade_blockers","relation":"references","confidence":"EXTRACTED","confidence_score":1,"source_file":"CLAUDE.md","source_location":null,"weight":1},{"source":"doc_claude_md","target":"concept_phpstan_ratchet","relation":"references","confidence":"EXTRACTED",