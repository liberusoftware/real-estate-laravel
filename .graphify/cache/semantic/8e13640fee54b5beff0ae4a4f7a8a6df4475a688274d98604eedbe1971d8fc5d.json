{"nodes":[{"id":"doc_meta_repository_scripts","label":"Liberu Meta Repository Scripts README","file_type":"document","source_file":"scripts/README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":null},{"id":"boilerplate_scripts_package","label":"liberusoftware/boilerplate-scripts","file_type":"document","source_file":"scripts/README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Release and maintenance automation is generic and shipped as a dev dependency rather than copied per meta repository, so every Composer-based meta repo whose modules and themes live in independent GitHub repositories runs the same tooling.","entity_type":"concept"},{"id":"liberu_meta_json","label":".liberu-meta.json meta-repository config","file_type":"document","source_file":"scripts/README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"One copied-and-customized config carries organization, genre, repository, component paths, prefixes and extra Composer packages, so the scripts stay generic.","entity_type":"concept"},{"id":"setup_sh","label":"setup.sh","file_type":"document","source_file":"scripts/README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Performs a repeatable local or production install without destructive migrations.","entity_type":"concept"},{"id":"update_sh","label":"update.sh","file_type":"document","source_file":"scripts/README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Updates dependencies and validates the project; --release 1.2.3 only commits, tags, pushes and creates the GitHub release after the checks succeed.","entity_type":"concept"},{"id":"submit_packagist","label":"submit-packagist.php","file_type":"document","source_file":"scripts/README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":null,"entity_type":"concept"},{"id":"fleet","label":"scripts/fleet","file_type":"document","source_file":"scripts/README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Fans a command across the component repositories once those repositories are the source of truth. tag is deliberately separate and only ever acts on an explicit --only list, because a tag is what gets published while a push is recoverable.","entity_type":"concept"},{"id":"publish_components","label":"publish-components (removed)","file_type":"document","source_file":"scripts/README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Rsynced a monorepo into its component repositories — the opposite direction, and meaningless once those repositories are the source of truth. Replaced by fleet.","entity_type":"concept"},{"id":"set_coverage_thresholds","label":"set-coverage-thresholds","file_type":"document","source_file":"scripts/README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Writes each measured figure into the package's tests.yml, ratcheting only upward — a package that has lost coverage keeps its threshold and is reported rather than silently lowered.","entity_type":"concept"},{"id":"measure_coverage","label":"measure-coverage","file_type":"document","source_file":"scripts/README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Resolves each package from nothing and runs its own suite under pcov, so the figure is evidence from a standalone resolution rather than the host's.","entity_type":"concept"},{"id":"measure_phpstan","label":"measure-phpstan","file_type":"document","source_file":"scripts/README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Finds the highest level each package's src/ passes by bisection over a standalone resolution; levels are monotone, so four runs settle it instead of eleven.","entity_type":"concept"},{"id":"set_phpstan_levels","label":"set-phpstan-levels","file_type":"document","source_file":"scripts/README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Writes each measured level into tests.yml as the reusable workflow's phpstan-level input, ratcheting only upward and preserving the existing coverage-threshold.","entity_type":"concept"},{"id":"quality_ratchet","label":"Upward-only quality ratchet","file_type":"document","source_file":"scripts/README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Both coverage thresholds and PHPStan levels are per-package figures that only ever rise; a regression is reported instead of relaxing the gate.","entity_type":"concept"},{"id":"non_interactive_fail_fast_commands","label":"Non-interactive, fail-on-error commands","file_type":"document","source_file":"scripts/README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"All commands are non-interactive and fail on errors so they can run unattended in CI.","entity_type":"concept"},{"id":"packagist_credentials_env","label":"Packagist credentials from the environment","file_type":"document","source_file":"scripts/README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"PACKAGIST_USERNAME and PACKAGIST_API_TOKEN are read from the environment and must never be committed; GitHub operations require an authenticated gh CLI.","entity_type":"concept"},{"id":"component_repos_source_of_truth","label":"Component repositories are the source of truth","file_type":"document","source_file":"scripts/README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Modules, themes and shared tooling live in independent GitHub repositories; the meta repository is Composer output, which is what makes a monorepo-to-package sync meaningless and a fan-out runner correct.","entity_type":"concept"},{"id":"coverage_tsv","label":"storage/app/coverage.tsv","file_type":"document","source_file":"scripts/README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":null,"entity_type":"concept"},{"id":"phpstan_tsv","label":"storage/app/phpstan.tsv","file_type":"document","source_file":"scripts/README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":null,"entity_type":"concept"},{"id":"package_tests_yml","label":"per-package tests.yml workflow inputs","file_type":"document","source_file":"scripts/README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":null,"entity_type":"concept"}],"edges":[{"source":"doc_meta_repository_scripts","target":"boilerplate_scripts_package","relation":"references","confidence":"EXTRACTED","confidence_score":1,"source_file":"scripts/README.md","source_location":null,"weight":1},{"source":"boilerplate_scripts_package","target":"setup_sh","relation":"references","confidence":"EXTRACTED","confidence_score":1,"source_file":"scripts/README.md","source_location":null,"weight":1},{"source":"setup_sh","target":"non_interactive_fail_fast_commands","relation":"implements","confidence":"EXTRACTED","confidence_score":1,"source_file":"scripts/README.md","source_location":null,"weight":1},{"source":"boilerplate_scripts_package","target":"update_sh","relation":"references","confidence":"EXTRACTED","confidence_score":1,"source_file":"scripts/README.md","source_location":null,"weight":1},{"source":"update_sh","target":"non_interactive_fail_fast_commands","relation":"impleme