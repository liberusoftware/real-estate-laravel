{"nodes":[{"id":"liberu_module_package_type","label":"liberu-module Composer package type","file_type":"document","source_file":"modules/activity-comments/README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Every module is an independently versioned Composer package of type liberu-module; hosts integrate through declared public boundaries rather than application-specific classes.","entity_type":"concept"},{"id":"liberu_composer_installer","label":"liberusoftware/composer-installer","file_type":"document","source_file":"modules/activity-comments/README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"The trusted installer places each package under /modules/<installer-name>. The installed directory stays tracked by the host repository while Composer and its lock file remain the source of version truth.","entity_type":"concept"},{"id":"installation_does_not_imply_enablement","label":"Installation does not imply enablement","file_type":"document","source_file":"modules/activity-comments/README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Installing a package implies neither runtime enablement nor commercial entitlement; enablement is a separate explicit decision driven by the manifest's default_enabled.","entity_type":"concept"},{"id":"module_category_foundation","label":"Module category: foundation","file_type":"document","source_file":"modules/activity-comments/README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":null,"entity_type":"concept"},{"id":"liberu_security_disclosure_policy","label":"Liberu security disclosure policy","file_type":"document","source_file":"modules/activity-comments/README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Vulnerabilitie