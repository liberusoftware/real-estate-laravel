{"nodes":[{"id":"doc_messaging_developer_notes","label":"Messaging Developer Notes","file_type":"document","source_file":"docs/MESSAGING_DEVELOPER_NOTES.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":null},{"id":"concept_message_policy","label":"MessagePolicy","file_type":"document","source_file":"docs/MESSAGING_DEVELOPER_NOTES.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Laravel Policies chosen over ad-hoc checks: standard pattern, centralized logic, easy to test, and works with Blade directives and middleware. Users view messages they sent or received, update only what they sent, delete either side.","entity_type":"concept"},{"id":"concept_message_encryption_at_rest","label":"Message encryption at rest","file_type":"document","source_file":"docs/MESSAGING_DEVELOPER_NOTES.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Laravel Crypt (AES-256-CBC) encrypts each message body individually. Chosen because it is built in, needs no extra infrastructure, and manages keys via APP_KEY. Per-message rather than per-column encryption allows selective decryption and least privilege. Trade-offs: encrypted messages cannot be searched without decrypting, and key rotation requires re-encrypting everything.","entity_type":"concept"},{"id":"concept_no_conversation_table","label":"No conversations table","file_type":"document","source_file":"docs/MESSAGING_DEVELOPER_NOTES.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Messages are stored directly and conversations derived dynamically: simpler schema, fewer joins, fast direct-message queries. Trade-off: adding group messaging would require refactoring to a conversations table plus a participants pivot.","entity_type":"concept"},{"id":"concept_conversation_indexes","label":"Conversation query indexes","file_type":"document","source_file":"docs/MESSAGING_DEVELOPER_NOTES.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Composite (sender_id, recipient_id) index optimizes the between() scope; a single recipient_id index optimizes unread-message queries used by the conversation list.","entity_type":"concept"},{"id":"concept_api_vs_web_route_split","label":"Separate API (Sanctum) and web (session) routes","file_type":"document","source_file":"docs/MESSAGING_DEVELOPER_NOTES.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Keeps the web UI on session auth while exposing the same behaviour to token clients; enables future mobile app integration without reworking authentication.","entity_type":"concept"},{"id":"concept_alpinejs_frontend_choice","label":"Alpine.js for the messaging UI","file_type":"document","source_file":"docs/MESSAGING_DEVELOPER_NOTES.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Chosen over Vue/React because it is lightweight, needs no build step for the MVP, integrates with Blade and matches the Livewire ecosystem. Migration to Livewire components is noted as a future option.","entity_type":"concept"},{"id":"concept_defense_in_depth_authorization","label":"Layered authorization","file_type":"document","source_file":"docs/MESSAGING_DEVELOPER_NOTES.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Authorization is checked at routes (middleware), controller (policy) and views (Blade directives) so a single missed check cannot bypass access control.","entity_type":"concept"},{"id":"concept_xss_prevention_json_directive","label":"@json() directive for JS contexts","file_type":"document","source_file":"docs/MESSAGING_DEVELOPER_NOTES.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Blade's @json() is used instead of raw {{ }} when embedding values into JavaScript, closing an XSS hole found in code review.","entity_type":"concept"},{"id":"concept_csrf_protection","label":"CSRF protection on state-changing requests","file_type":"document","source_file":"docs/MESSAGING_DEVELOPER_NOTES.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":null,"entity_type":"concept"}],"edges":[{"source":"doc_messaging_developer_notes","target":"concept_message_encryption_at_rest","relation":"references","confidence":"EXTRACTED","confidence_score":1,"source_file":"docs/MESSAGING_DEVELOPER_NOTES.md","source_location":null,"weight":1},{"source":"doc_messaging_developer_notes","target":"concept_message_policy","relation":"references","confidence":"EXTRACTED","confidence_score":1,"source_file":"docs/MESSAGING_DEVELOPER_NOTES.md","source_location":null,"weight":1},{"source":"doc_messaging_developer_notes","target":"concept_api_vs_web_route_split","relation":"references","confidence":"EXTRACTED","confidence_score":1,"source_file":"docs/MESSAGING_DEVELOPER_NOTES.md","source_location":null,"weight":1},{"source":"doc_messaging_developer_notes","target":"concept_alpinejs_frontend_choice","relation":"references","confidence":"EXTRACTED","confidence_score":1,"source_file":"docs/MESSAGING_DEVELOPER_NOTES.md","source_location":null,"weight":1},{"source":"doc_messaging_developer_notes","target":"concept_no_conversation_table","relation":"references","confidence":"EXTRACTED","confidence_score":1,"source_file":"docs/MESSAGING_DEVELOPER_NOTES.md","source_location":null,"weight":1},{"source":"doc_messaging_developer_notes","target":"concept_conversation_indexes","relation":"references","confidence":"EXTRACTED","confidence_score":1,"source_file":"docs/MESSAGING_DEVELOPER_NOTES.md","source_location":null,"weight":1},{"source":"doc_messaging_developer_notes","target":"concept_defense_in_depth_au