{"nodes":[{"id":"doc_module_development","label":"Module Development Guide","file_type":"document","source_file":"docs/MODULE_DEVELOPMENT.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":null},{"id":"concept_liberu_module_package","label":"liberu-module Composer package","file_type":"document","source_file":"docs/MODULE_DEVELOPMENT.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Modules are independently versioned Composer packages installed into modules/{name}; Composer owns discovery and autoloading.","entity_type":"concept"},{"id":"concept_module_manifest","label":"module.json manifest","file_type":"document","source_file":"docs/MODULE_DEVELOPMENT.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Owns runtime metadata, provided/required capabilities, enablement defaults and Filament plugin declarations, separate from Composer's installation metadata.","entity_type":"concept"},{"id":"concept_module_capabilities","label":"Capability declarations (provides / requires)","file_type":"document","source_file":"docs/MODULE_DEVELOPMENT.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Dependencies are declared twice on purpose: Composer require controls installation and autoloading, manifest requires/required_capabilities control the enabled runtime graph.","entity_type":"concept"},{"id":"concept_module_categories","label":"Module categories","file_type":"document","source_file":"docs/MODULE_DEVELOPMENT.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"integration, domain, presentation or theme; framework presentation dependencies must stay out of domain packages.","entity_type":"concept"},{"id":"concept_module_enablement","label":"Explicit module enablement","file_type":"document","source_file":"docs/MODULE_DEVELOPMENT.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Bundled packages default to disabled in their manifests and the application enables its composition explicitly, so installing a package never implies booting it.","entity_type":"concept"},{"id":"concept_module_manager","label":"Module manager (provider lifecycle authority)","file_type":"document","source_file":"docs/MODULE_DEVELOPMENT.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"The root application bootstraps only the module manager, which discovers installed liberu-module packages, validates the graph, orders providers by dependency and registers only enabled modules.","entity_type":"concept"},{"id":"concept_no_laravel_auto_discovery","label":"No extra.laravel.providers auto-discovery","file_type":"document","source_file":"docs/MODULE_DEVELOPMENT.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Runtime modules declare their provider in extra.liberu.provider and must not use Laravel's auto-discovery, because the module manager is the single provider lifecycle authority.","entity_type":"concept"},{"id":"concept_module_validate_command","label":"module:validate command","file_type":"document","source_file":"docs/MODULE_DEVELOPMENT.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Checks that Liberu package dependencies are represented consistently, required versions are installed, providers are valid, capability providers are unambiguous and the enabled graph has no gaps or cycles.","entity_type":"concept"},{"id":"concept_no_cross_module_table_access","label":"No informal cross-module integration","file_type":"document","source_file":"docs/MODULE_DEVELOPMENT.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"A module must not query another module's tables or import its models as an integration API; use a contract, application service, event or documented schema extension instead.","entity_type":"concept"},{"id":"concept_contract_package","label":"Contract packages","file_type":"document","source_file":"docs/MODULE_DEVELOPMENT.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Small shared-interface packages let adapters depend on a stable boundary without importing an implementation.","entity_type":"concept"},{"id":"concept_filament_presentation_module","label":"Companion *-filament presentation module","file_type":"document","source_file":"docs/MODULE_DEVELOPMENT.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Filament code lives in a companion presentation package rather than its domain module, keeping domain packages presentation-agnostic.","entity_type":"concept"},{"id":"concept_filament_plugin_declaration","label":"filament_plugins manifest declaration","file_type":"document","source_file":"docs/MODULE_DEVELOPMENT.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"The presentation manifest names which panel (admin or app) receives its plugin class; plugin identifiers must be unique within a panel.","entity_type":"concept"},{"id":"concept_module_plugins_composer","label":"App\\Filament\\ModulePlugins","file_type":"document","source_file":"docs/MODULE_DEVELOPMENT.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Composes plugin instances from enabled manifests so panel providers never hard-code module plugins.","entity_type":"concept"},{"id":"concept_admin_panel","label":"Admin Filament panel","file_type":"document","source_file":"docs/MODULE_DEVELOPMENT.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Panel key 'admin' is for operational management surfaces.","entity_type":"concept"},{"id":"concept_app_panel","label":"App Filament panel","file_type":"document","source_file":"docs/MODULE_DEVELOPMENT.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Panel key 'app' is for tenant/user-facing functionality.","entity_type":"concept"},{"id":"concept_package_owned_tests","label":"Package-owned tests","file_type":"document","source_file":"docs/MODULE_DEVELOPMENT.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Every module carries its own tests under modules/{name}/tests, at minimum metadata tests verifying Composer/manifest agreement, dependencies and the provider.","entity_type":"concept"},{"id":"concept_reproducible_composition","label":"Reproducible composition from the lockfile","file_type":"document","source_file":"docs/MODULE_DEVELOPMENT.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Hidden filesystem-scanning conventions are avoided so Composer metadata, the manifest and explicit enablement are enough to reproduce the composition.","entity_type":"concept"},{"id":"concept_module_release_workflow","label":"Module release workflow","file_type":"document","source_file":"docs/MODULE_DEVELOPMENT.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Update the changelog, validate the graph, run focused and root suites, release from the package repository, then update the consuming application's constraint and lockfile.","entity_type":"concept"}],"edges":[{"source":"doc_module_development","target":"concept_liberu_module_package","relation":"references","confidence":"EXTRACTED","confidence_score":1,"source_file":"docs/MODULE_DEVELOPMENT.md","source_location":null,"weig