{"nodes":[{"id":"doc_theme_base_readme","label":"Liberu Base theme README","file_type":"document","source_file":"themes/base/README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":null},{"id":"theme_manifest","label":"theme.json manifest","file_type":"document","source_file":"themes/base/README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"The manifest is the single declared surface for name, type, parent and asset entry points; it is the only asset entry-point index, so build inputs are derived from it rather than listed twice.","entity_type":"concept"},{"id":"theme_inheritance","label":"Theme parent inheritance chain","file_type":"document","source_file":"themes/base/README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"A public theme declares base as its parent and resolves missing views and assets up the chain, so only the shared root has to ship every layout.","entity_type":"concept"},{"id":"theme_type_shared","label":"Theme type: shared","file_type":"document","source_file":"themes/base/README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":null,"entity_type":"concept"},{"id":"theme_support_package","label":"liberusoftware/theme-support","file_type":"document","source_file":"themes/base/README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":null,"entity_type":"concept"},{"id":"presentation_only_package","label":"Presentation-only package boundary","file_type":"document","source_file":"themes/base/README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"A theme carries no domain behaviour — that stays in modules — and the host keeps control of theme selection and fallback, so a theme can never become a place where business rules hide.","entity_type":"concept"},{"id":"theme_fallback","label":"Safe theme fallback","file_type":"document","source_file":"themes/base/README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Hosts must retain a working base/default theme so that an unavailable optional asset or capability degrades instead of breaking the page.","entity_type":"concept"},{"id":"theme_accessibility_baseline","label":"Theme accessibility baseline","file_type":"document","source_file":"themes/base/README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Keyboard access, visible focus, semantic landmarks, readable contrast, reduced motion, zoom/reflow and system-font fallbacks are required of every theme, not optional polish.","entity_type":"concept"},{"id":"vite_build_pipeline","label":"Host Vite build of theme entry points","file_type":"document","source_file":"themes/base/README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"vite.config.js derives its inputs from themes/*/theme.json, so installing a theme is enough to get it built — and a directory rename changes the input set, requiring a rebuild.","entity_type":"concept"},{"id":"theme_declared_entry_points","label":"Declared asset entry points (resources/css/app.css, resources/js/app.js)","file_type":"document","source_file":"themes/base/README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":null,"entity_type":"concept"},{"id":"theme_no_bundled_third_party_assets","label":"No bundled third-party assets without provenance","file_type":"document","source_file":"themes/base/README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Themes ship their own sources only; any font, image, icon, video or template added later must carry its licence and attribution.","entity_type":"concept"},{"id":"theme_testing_expectations","label":"Theme testing expectations","file_type":"document","source_file":"themes/base/README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Manifest parsing, provider registration, production asset compilation, supported host surfaces, responsive layout, keyboard navigation, contrast and fallback are all validated, and visual changes carry before/after evidence.","entity_type":"concept"},{"id":"theme_missing_preview_image","label":"Unpublished theme preview image","file_type":"document","source_file":"themes/base/README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"No maintained preview is published yet; one must be added under .github/assets/ before claiming visual-regression coverage.","entity_type":"concept"},{"id":"theme_security_disclosure","label":"Private security disclosure (security@liberusoftware.com)","file_type":"document","source_file":"themes/base/README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Vulnerabilities must not be reported through public issues.","entity_type":"concept"},{"id":"host_boilerplate_laravel","label":"liberusoftware/boilerplate-laravel host","file_type":"document","source_file":"themes/base/README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":null,"entity_type":"concept"},{"id":"theme_base","label":"base theme (Liberu Base)","file_type":"document","source_file":"themes/base/README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Shared semantic tokens, accessible layout and progressive presentation primitives live at the shared root so every public theme inherits one accessible baseline.","entity_type":"concept"},{"id":"pkg_theme_base","label":"liberusoftware/theme-base","file_type":"document","source_file":"themes/base/README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":null,"entity_type":"concept"},{"id":"capability_foundation_localization","label":"Optional capability: foundation.localization","file_type":"document","source_file":"themes/base/README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":null,"entity_type":"concept"},{"id":"theme_supported_surfaces","label":"Declared supported host surfaces","file_type":"document","source_file":"themes/base/README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"A theme names the host surfaces it supports (application.shell, identity.auth, foundation.account, blog.index) so a host can tell before installing which screens it actually covers.","entity_type":"concept"}],"edges":[{"source":"pkg_theme_base","target":"theme_base","relation":"implements","confidence":"EXTRACTED","confidence_score":1,"source_file":"themes/base/README.md","source_location":null,"weight":1},{"source":"theme_base","target":"theme_manifest","relation":"implements","confidence":"EXTRACTED","confidence_score":1,"source_file":"themes/base/README.md","source_location":null,"weight":1},{"source":"theme_base","target":"presentation_only_package","relation":"implements","confidence":"EXTRACTED","confidence_score":1,"source_file":"themes/base/README.md","source_location":null,"weight":1},{"source":"theme_base","target":"theme_accessibility_baseline","relation":"implements","confidence":"EXTRACTED","confidence_score":1,"source_file":"themes/base/README.md","source_location":null,"weight":1},{"source":"theme_base","target":"theme_fallback","relation":"references","confidence":"EXTRACTED","confidence_score":1,"source_file":"themes/base/README.md","source_location":null,"weight":1}