{"nodes":[{"id":"doc_real_estate_scope","label":"Liberu Real Estate scope (REAL-ESTATE.md)","file_type":"document","source_file":"projects/real-estate/REAL-ESTATE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":null},{"id":"real_estate_scope","label":"Liberu Real Estate scope","file_type":"document","source_file":"projects/real-estate/REAL-ESTATE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"The scope covers agency operations end to end (properties, parties, listings, viewings, offers, progression, lettings, management, marketing, portal reporting) so that each capability is a separately releasable boundary rather than one monolithic estate-agency application.","entity_type":"concept"},{"id":"framework_neutral_core_boundary","label":"Framework-neutral core boundary","file_type":"document","source_file":"projects/real-estate/REAL-ESTATE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Each capability has exactly one core boundary that carries no presentation framework, so the domain can be consumed by API, Filament or Livewire adapters interchangeably and the same rules hold whichever surface is installed.","entity_type":"concept"},{"id":"one_to_one_adapter_rule","label":"One-to-one adapter rule","file_type":"document","source_file":"projects/real-estate/REAL-ESTATE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Adapters are optional and map one-to-one onto a core package, so a surface can be added or dropped without touching the domain and no adapter accumulates behaviour for more than one capability.","entity_type":"concept"},{"id":"real_estate_delivery_order","label":"Real Estate delivery order (three phases)","file_type":"document","source_file":"projects/real-estate/REAL-ESTATE.md","source_location":null,"source_url":