{"nodes":[{"id":"module_manager_module","label":"Liberu Module Manager","file_type":"document","source_file":"modules/module-manager/README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Owns manifest discovery, dependency resolution, deployment enablement, registry caching and diagnostics for the whole composition, so enablement is a decision the manager resolves rather than a side effect of Composer install."},{"id":"composer_installer","label":"liberusoftware/composer-installer","file_type":"document","source_file":"modules/module-manager/README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"A trusted Composer installer places each package under /modules/<installer-name>. The installed directory stays tracked by the host repository while Composer and its lock file remain the source of version truth.","entity_type":"concept"},{"id":"installation_not_enablement","label":"Installation Does Not Imply Enablement","file_type":"document","source_file":"modules/module-manager/README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Every module README states that installation implies neither runtime enablement nor commercial entitlement, so adding a package to the composition is a separate decision from booting it.","entity_type":"concept"},{"id":"enabled_by_default_declaration","label":"Enabled By Default Declaration","file_type":"document","source_file":"modules/module-manager/README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"All ten templated module READMEs in this chunk declare `Enabled by default: no`, including foundation packages such as module-manager, localization, notifications, observability, organizations-teams and profiles. The host CLAUDE.md instead states 37 of 40 manifests set default_enabled true, so README and manifest may disagree - flagged for review.","entity_type":"concept"},{"id":"capability_declaration","label":"Capability Declaration","file_type":"document","source_file":"modules/module-manager/README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Each package exports named capabilities (e.g. foundation.modules, identity.profiles) that hosts and dependent modules bind to, instead of coupling to application-specific classes.","entity_type":"concept"},{"id":"package_category_foundation","label":"Package Category: foundation","file_type":"document","source_file":"modules/module-manager/README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":null,"entity_type":"concept"},{"id":"service_provider_registration","label":"Manifest Service Provider","file_type":"document","source_file":"modules/module-manager/README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Each manifest names one service provider class under the Liberu\\Foundation namespace; the host registers it explicitly rather than through extra.laravel.providers auto-discovery.","entity_type":"concept"},{"id":"declared_public_boundary","label":"Declared Public Boundary","file_type":"document","source_file":"modules/module-manager/README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Hosts integrate a package through its declared provider, capabilities and published contracts; consumers must not couple to internal tables or classes, and authorization stays the host's responsibility unless a public authorizer contract is published.","entity_type":"concept"},{"id":"standalone_package_test_suite","label":"Standalone Package Test Suite","file_type":"document","source_file":"modules/module-manager/README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Every package ships its own tests, run from a compatible host checkout as `vendor/bin/pest modules/<name>/tests`; changes must preserve the manifest, provider integration, package boundaries and declared PHP/Laravel compatibility.","entity_type":"concept"},{"id":"module_features_command","label":"module:features Console Command","file_type":"document","source_file":"modules/module-manager/README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Lists or searches feature declarations across installed modules, making the fleet's declared features queryable from one place.","entity_type":"concept"},{"id":"cache_modules_command","label":"CacheModulesCommand","file_type":"document","source_file":"modules/module-manager/README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":null,"entity_type":"concept"},{"id":"clear_modules_command","label":"ClearModulesCommand","file_type":"document","source_file":"modules/module-manager/README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":null,"entity_type":"concept"},{"id":"list_modules_command","label":"ListModulesCommand","file_type":"document","source_file":"modules/module-manager/README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":null,"entity_type":"concept"},{"id":"module_status_command","label":"ModuleStatusCommand","file_type":"document","source_file":"modules/module-manager/README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":null,"entity_type":"concept"},{"id":"validate_modules_command","label":"ValidateModulesCommand","file_type":"document","source_file":"modules/module-manager/README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":n