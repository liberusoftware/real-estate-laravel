    {"id": "concept_team_scoping", "label": "Team-Scoped Records", "file_type": "concept", "source_file": "modules/real-estate-properties/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every real-estate domain package scopes its records to a team; actor and team IDs are passed explicitly at mutation boundaries rather than read from ambient application state, which keeps the packages free of the host's tenancy plumbing."},
    {"id": "concept_presentation_neutral_core", "label": "Presentation-Neutral Domain Core", "file_type": "concept", "source_file": "modules/real-estate-properties/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A domain package owns the rules and the tables; API, Filament and Livewire adapters are published separately and depend on the core rather than duplicating its rules. This is what lets a presentation technology be swapped or omitted without touching the domain."},
    {"id": "concept_four_package_adapter_split", "label": "Core/API/Filament/Livewire Package Split", "file_type": "concept", "source_file": "modules/real-estate-sales-progression/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each real-estate domain ships as up to four independently published packages: a presentation-neutral core plus -api, -filament and -livewire adapters. Independence means a consumer installs only the surfaces it needs."},
    {"id": "concept_unprefixed_composer_naming", "label": "Unprefixed Composer Name vs module- GitHub Repo", "file_type": "concept", "source_file": "modules/real-estate-property-management/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The Composer/Packagist package name drops the module- prefix that the GitHub source repository carries, so the same package is addressed by two different names depending on which system is naming it."},
    {"id": "concept_no_app_namespace_dependency", "label": "No App\\ Namespace Dependency", "file_type": "concept", "source_file": "modules/real-estate-properties/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A module never assumes application App\\ classes exist, so it can be installed standalone and tested without the host."},
    {"id": "concept_module_owns_own_tables", "label": "Migration Owns Only the Package's Tables", "file_type": "concept", "source_file": "modules/real-estate-properties/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A module's migration creates only the tables that package owns, and disabling the module does not delete data — enablement is a boot decision, not a data lifecycle decision."},
    {"id": "concept_immutable_history_entries", "label": "Immutable Property History Entries", "file_type": "concept", "source_file": "modules/real-estate-properties/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Property changes are recorded as immutable history entries rather than in-place edits, preserving an audit trail of lifecycle status changes."},
    {"id": "concept_replaceable_integration_services", "label": "Replaceable Integration Services", "file_type": "concept", "source_file": "modules/real-estate-rightmove/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Provider credentials and transport live in replaceable integration services outside the sync core, so a portal provider can be swapped without touching domain records."},
    {"id": "concept_sanctum_bearer_security", "label": "Sanctum Bearer Security Scheme", "file_type": "concept", "source_file": "modules/real-estate-valuations-api/openapi/v1/real-estate-valuations.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every real-estate API spec declares a single securitySchemes entry: http bearer with bearerFormat Sanctum, applied document-wide via top-level security."},
    {"id": "concept_idempotency_key_header", "label": "Idempotency-Key Header (x-liberu-idempotency-header)", "file_type": "concept", "source_file": "modules/real-estate-valuations-api/openapi/v1/real-estate-valuations.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A fleet-wide x-liberu-idempotency-header vendor extension names Idempotency-Key on every API spec, so retried writes are safe across all real-estate adapters by a single shared convention."},
    {"id": "concept_error_schema", "label": "Shared Error Schema", "file_type": "concept", "source_file": "modules/real-estate-valuations-api/openapi/v1/real-estate-valuations.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Identical Error component in every spec: required message, plus optional code and a free-form errors object."},
    {"id": "concept_pagination_meta_schema", "label": "Shared PaginationMeta Schema", "file_type": "concept", "source_file": "modules/real-estate-valuations-api/openapi/v1/real-estate-valuations.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Identical PaginationMeta component in every spec: current_page, per_page, total and last_page all required."},
    {"id": "concept_openapi_31_versioned_contract", "label": "OpenAPI 3.1.0 Versioned API Contract", "file_type": "concept", "source_file": "modules/real-estate-rightmove-api/openapi/v1/real-estate-rightmove.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each -api package ships its contract under openapi/v1/, matching the /api/v1/ route prefix, so an API version is a directory of the adapter rather than a branch of the domain."},
    {"id": "concept_archive_instead_of_delete", "label": "Archive Instead of Hard Delete", "file_type": "concept", "source_file": "modules/real-estate-rightmove-api/openapi/v1/real-estate-rightmove.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rightmove and sales-progression DELETE endpoints return 204 described as 'Archived', preserving records rather than destroying them; the valuations and viewings specs describe the same verb as 'Deleted', so the convention is not uniform across the fleet."},
    {"id": "concept_valuation_workflow_transitions", "label": "Valuation Workflow Transitions", "file_type": "concept", "source_file": "modules/real-estate-valuations-api/openapi/v1/real-estate-valuations.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Valuation state changes are POST sub-resources (schedule, complete, convert, comparables) rather than PATCH field writes, so each transition is an explicit named operation with its own authorization."},
    {"id": "concept_viewing_lifecycle_transitions", "label": "Viewing Lifecycle Transitions", "file_type": "concept", "source_file": "modules/real-estate-viewings-api/openapi/v1/real-estate-viewings.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Viewing state changes are POST sub-resources (confirm, complete, cancel, no-show) rather than PATCH field writes, making each lifecycle move a distinct named operation."},
    {"id": "concept_rightmove_sync_operation", "label": "Rightmove Sync Operation", "file_type": "concept", "source_file": "modules/real-estate-rightmove-api/openapi/v1/real-estate-rightmove.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Synchronizing a listing is a POST on the sync record itself (real.estate.rightmove.sync), colliding on the same path as the GET/PATCH/DELETE record operations."},

